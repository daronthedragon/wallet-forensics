# ---- EVM history ----
# Etherscan V2 unified API key — ONE key covers every supported EVM chain
# (Ethereum, Base, Arbitrum, Optimism, Polygon). Free tier is enough.
# https://etherscan.io/apis
#
# Without a key, history falls back to Blockscout, which needs no key but is
# less complete on some chains.
ETHERSCAN_API_KEY=

# ---- EVM RPC endpoints ----
# All have working public defaults. Approval scanning needs an endpoint that
# permits unbounded eth_getLogs — public nodes usually reject it, in which case
# the tool falls back to deriving approvals from transaction history and says so.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ---- Solana ----
# The public endpoint is heavily rate limited and will 429 on active wallets.
# Helius / Triton / QuickNode strongly recommended.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Pricing ----
# Optional. Raises CoinGecko rate limits considerably.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# ---- Exit liquidity ----
# Jupiter free tier endpoint (Solana routing).
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
