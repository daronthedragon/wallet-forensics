# ---- Ethereum ----
# Any JSON-RPC endpoint. Alchemy/Infura/QuickNode/public all work.
# An archive-capable endpoint gives better historical accuracy.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Etherscan V2 unified API key (one key covers all supported chains).
# Free tier is enough. https://etherscan.io/apis
# Without this, transaction history falls back to log-scanning (slower, less complete).
ETHERSCAN_API_KEY=

# ---- Solana ----
# Public endpoint is heavily rate limited. Helius/Triton/QuickNode recommended.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Pricing ----
# CoinGecko demo key is optional but raises rate limits considerably.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# ---- Exit liquidity quotes ----
# Jupiter free tier endpoint (Solana routing).
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
